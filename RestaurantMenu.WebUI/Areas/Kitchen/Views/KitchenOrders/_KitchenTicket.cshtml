@using RestaurantMenu.Business.Orders
@model Order
@{
    var createdUtc = DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc).ToString("o");
    var targets = OrderStatusMachine.GetAllowedTargets(Model.Status)
        .Where(next => OrderStatusPolicy.CanKitchenChange(Model.Status, next))
        .ToList();
}
<article class="kds-ticket">
    <div class="kds-ticket-head">
        <div>
            <div class="kds-order-no">@Model.OrderNumber</div>
            <div class="kds-table">@Model.Table.Name</div>
        </div>
        <div class="kds-time" data-elapsed="@createdUtc">az önce</div>
    </div>

    <ul class="kds-items">
        @foreach (var item in Model.Items)
        {
            <li>
                <span class="kds-qty">@item.Quantity</span>
                <span>
                    @item.ProductNameSnapshot
                    @if (!string.IsNullOrWhiteSpace(item.Note))
                    {
                        <span class="kds-item-note">@item.Note</span>
                    }
                </span>
            </li>
        }
    </ul>

    @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
    {
        <div class="kds-order-note">Sipariş notu: @Model.CustomerNote</div>
    }

    @if (targets.Count > 0)
    {
        <div class="kds-actions">
            @foreach (var next in targets)
            {
                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="nextStatus" value="@next" />
                    <button type="submit" class="btn btn-sm @(next == OrderStatus.Cancelled ? "" : "btn-go")">@DisplayTexts.OrderStatus(next)</button>
                </form>
            }
        </div>
    }
    else if (Model.Status == OrderStatus.Ready)
    {
        <div class="kds-order-note">Servis ve tamamlandı garson panelinden güncellenir.</div>
    }
</article>
