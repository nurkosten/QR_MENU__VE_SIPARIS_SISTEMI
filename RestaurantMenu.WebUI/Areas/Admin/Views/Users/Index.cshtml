@model List<(ApplicationUser User, string Roles)>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="page-head">
    <div>
        <h1>Kullanıcılar</h1>
        <p class="page-sub">@Model.Count hesap · restoran sahibi yalnızca kendi personelini yönetir</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary btn-sm" asp-action="Create">
            <partial name="_Icon" model='"plus"' /> Yeni kullanıcı
        </a>
    </div>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><partial name="_Icon" model='"users"' /></div>
            <div class="empty-title">Kullanıcı bulunamadı</div>
            <p class="empty-text">Personel ve mutfak ekranlarını kullanacak hesapları burada tanımlayın.</p>
            <a class="btn btn-primary btn-sm" asp-action="Create">Kullanıcı ekle</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-stack js-datatable">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Restoran</th>
                        <th>Durum</th>
                        <th class="no-sort"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var name = string.IsNullOrWhiteSpace(row.User.FullName) ? row.User.Email ?? "-" : row.User.FullName;
                        <tr>
                            <td class="cell-main">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar" style="background:var(--surface-2);color:var(--ink-500);">@(name.Length > 0 ? name[..1].ToUpperInvariant() : "?")</span>
                                    <span class="cell-title">@name</span>
                                </div>
                            </td>
                            <td data-label="E-posta">@row.User.Email</td>
                            <td data-label="Rol"><span class="badge bg-light no-dot">@row.Roles</span></td>
                            <td data-label="Restoran">@(row.User.Restaurant?.Name ?? "—")</td>
                            <td data-label="Durum">
                                @if (row.User.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-outline-dark btn-sm" asp-action="Edit" asp-route-id="@row.User.Id">
                                    <partial name="_Icon" model='"pencil"' /> Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
