@model ProductFormViewModel
@{
    ViewData["Title"] = "Ürün düzenle";
}
<h1 class="h4">Ürün düzenle</h1>
<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="Price"></label><input asp-for="Price" class="form-control" /></div>
    <div class="form-check mb-2"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable"></label></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive"></label></div>
    @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
    {
        <img src="@Model.ExistingImageUrl" class="mb-2" alt="" style="height:80px;" />
    }
    <div class="mb-3"><input type="file" name="image" class="form-control" /></div>
    <button class="btn btn-dark">Kaydet</button>
</form>
