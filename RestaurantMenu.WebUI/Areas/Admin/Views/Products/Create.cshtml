@model ProductFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Ürün ekle" : "Ürün düzenle";
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">Menüde görünecek ürün bilgilerini girin</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost btn-sm" asp-action="Index">
            <partial name="_Icon" model='"arrow-left"' /> Ürünlere dön
        </a>
    </div>
</div>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Ürün bilgileri</h2></div>
                <div class="panel-body">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
                    <div class="form-grid">
                        <div>
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Örn. Izgara köfte" />
                            <span asp-validation-for="Name" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
                            <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                        </div>
                        <div class="col-full">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kısa tanıtım metni"></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel mb-3">
                <div class="panel-head"><h2 class="panel-title">Yayın durumu</h2></div>
                <div class="panel-body">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsAvailable" class="form-check-input" />
                        <label asp-for="IsAvailable" class="form-check-label">Satışta</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Aktif</label>
                    </div>
                    <p class="field-hint">Ürünün menüde görünmesi için her iki seçeneğin de açık olması gerekir.</p>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Görsel</h2></div>
                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                    {
                        <img src="@Model.ExistingImageUrl" alt="Ürün görseli" class="mb-2 rounded" style="height:96px;object-fit:cover;" />
                    }
                    <input type="file" name="image" class="form-control" accept="image/*" />
                    <p class="field-hint">JPG veya PNG yükleyebilirsiniz.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <a class="btn btn-ghost" asp-action="Index">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
