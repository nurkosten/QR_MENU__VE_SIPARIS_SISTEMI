@model CategoryFormViewModel
@{
    ViewData["Title"] = "Kategori düzenle";
}

<div class="page-head">
    <div>
        <h1>Kategori düzenle</h1>
        <p class="page-sub">@Model.Name</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost btn-sm" asp-action="Index">
            <partial name="_Icon" model='"arrow-left"' /> Kategorilere dön
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-body">
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                    <div class="form-grid">
                        <div class="col-full">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" class="form-control" />
                            <p class="field-hint">Küçük değer menüde daha üstte görünür.</p>
                            <span asp-validation-for="DisplayOrder" class="field-validation-error"></span>
                        </div>
                        <div>
                            <label class="form-label d-block">Görünürlük</label>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                            <p class="field-hint">Pasif kategoriler müşteri menüsünde gösterilmez.</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn-primary" type="submit">Kaydet</button>
                        <a class="btn btn-ghost" asp-action="Index">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
