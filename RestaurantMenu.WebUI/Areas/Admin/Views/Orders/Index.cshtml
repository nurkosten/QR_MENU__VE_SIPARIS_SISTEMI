@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Siparişler";
    OrderStatus? status = ViewBag.Status as OrderStatus?;
}
<h1 class="h4">Siparişler</h1>
<form method="get" class="mb-3">
    <select name="status" class="form-select w-auto d-inline" onchange="this.form.submit()">
        <option value="">Tümü</option>
        @foreach (OrderStatus value in Enum.GetValues<OrderStatus>())
        {
            <option value="@value" selected="@(status == value)">@DisplayTexts.OrderStatus(value)</option>
        }
    </select>
</form>
<table class="table bg-white">
    <thead><tr><th>No</th><th>Masa</th><th>Durum</th><th>Tutar</th><th></th></tr></thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.OrderNumber</td>
            <td>@order.Table.Name</td>
            <td><span class="badge bg-@DisplayTexts.StatusBadge(order.Status)">@DisplayTexts.OrderStatus(order.Status)</span></td>
            <td>@order.TotalAmount.ToString("C")</td>
            <td><a asp-action="Details" asp-route-id="@order.Id">Detay</a></td>
        </tr>
    }
    </tbody>
</table>
