@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Siparişler";
    OrderStatus? status = ViewBag.Status as OrderStatus?;
}

<div class="page-head">
    <div>
        <h1>Siparişler</h1>
        <p class="page-sub">
            @Model.Count kayıt
            @if (status is not null)
            {
                <span> · @DisplayTexts.OrderStatus(status.Value) filtresi</span>
            }
        </p>
    </div>
</div>

<nav class="chip-nav" aria-label="Durum filtresi">
    <a class="cat-chip @(status is null ? "on" : "")" asp-action="Index">Tümü</a>
    @foreach (OrderStatus value in Enum.GetValues<OrderStatus>())
    {
        <a class="cat-chip @(status == value ? "on" : "")" asp-action="Index" asp-route-status="@value">@DisplayTexts.OrderStatus(value)</a>
    }
</nav>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><partial name="_Icon" model='"inbox"' /></div>
            <div class="empty-title">Sipariş bulunamadı</div>
            <p class="empty-text">Seçtiğiniz filtreye uyan sipariş yok. Filtreyi değiştirip tekrar deneyin.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr>
                        <th>Sipariş</th>
                        <th>Masa</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th class="num">Tutar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="cell-main">
                                <span class="cell-title d-block">@order.OrderNumber</span>
                                <span class="cell-sub">@order.Items.Sum(i => i.Quantity) ürün</span>
                            </td>
                            <td data-label="Masa">@order.Table.Name</td>
                            <td data-label="Durum"><span class="badge bg-@DisplayTexts.StatusBadge(order.Status)">@DisplayTexts.OrderStatus(order.Status)</span></td>
                            <td data-label="Tarih"><span class="cell-sub">@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></td>
                            <td class="num money" data-label="Tutar">@order.TotalAmount.ToString("C")</td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn-outline-dark btn-sm" asp-action="Details" asp-route-id="@order.Id">Detay</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
