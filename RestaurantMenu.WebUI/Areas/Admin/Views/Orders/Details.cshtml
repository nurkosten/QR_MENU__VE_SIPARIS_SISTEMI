@using RestaurantMenu.Business.Orders
@model Order
@{
    ViewData["Title"] = Model.OrderNumber;
}
<h1 class="h4">@Model.OrderNumber</h1>
<p>Masa: @Model.Table.Name</p>
<p>Durum: <span class="badge bg-@DisplayTexts.StatusBadge(Model.Status)">@DisplayTexts.OrderStatus(Model.Status)</span></p>
<ul>
    @foreach (var item in Model.Items)
    {
        <li>@item.ProductNameSnapshot x @item.Quantity — @item.LineTotal.ToString("C")</li>
    }
</ul>
<p class="fw-semibold">Toplam: @Model.TotalAmount.ToString("C")</p>
@foreach (var next in OrderStatusMachine.GetAllowedTargets(Model.Status))
{
    <form asp-action="ChangeStatus" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="nextStatus" value="@next" />
        <button class="btn btn-sm btn-outline-dark">@DisplayTexts.OrderStatus(next)</button>
    </form>
}
<p class="mt-3"><a asp-action="Index">Listeye dön</a></p>
