@using RestaurantMenu.Business.Orders
@model Order
@{
    ViewData["Title"] = "Sipariş " + Model.OrderNumber;
    var transitions = OrderStatusMachine.GetAllowedTargets(Model.Status).ToList();
}

<div class="page-head">
    <div>
        <h1>@Model.OrderNumber</h1>
        <p class="page-sub">@Model.Table.Name · @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost btn-sm" asp-action="Index">
            <partial name="_Icon" model='"arrow-left"' /> Listeye dön
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-head">
                <h2 class="panel-title">Sipariş içeriği</h2>
                <span class="chip">@Model.Items.Sum(i => i.Quantity) ürün</span>
            </div>
            @foreach (var item in Model.Items)
            {
                <div class="list-row">
                    <div class="list-row-main">
                        <div class="list-row-title">@item.ProductNameSnapshot</div>
                        <div class="list-row-sub">
                            @item.UnitPrice.ToString("C") × @item.Quantity
                            @if (!string.IsNullOrWhiteSpace(item.Note))
                            {
                                <span> · @item.Note</span>
                            }
                        </div>
                    </div>
                    <div class="money">@item.LineTotal.ToString("C")</div>
                </div>
            }
            <div class="panel-body">
                <div class="summary">
                    <div class="summary-row total"><span>Toplam</span><span>@Model.TotalAmount.ToString("C")</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel mb-3">
            <div class="panel-head">
                <h2 class="panel-title">Durum</h2>
                <span class="badge bg-@DisplayTexts.StatusBadge(Model.Status)">@DisplayTexts.OrderStatus(Model.Status)</span>
            </div>
            <div class="panel-body">
                @if (transitions.Count == 0)
                {
                    <p class="text-muted mb-0">Bu sipariş için yapılabilecek bir durum değişikliği kalmadı.</p>
                }
                else
                {
                    <p class="field-hint mt-0">Siparişi bir sonraki aşamaya taşıyın.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var next in transitions)
                        {
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="nextStatus" value="@next" />
                                <button type="submit" class="btn btn-outline-dark btn-sm">@DisplayTexts.OrderStatus(next)</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
        {
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Müşteri notu</h2></div>
                <div class="panel-body">
                    <p class="mb-0 text-muted">@Model.CustomerNote</p>
                </div>
            </div>
        }
    </div>
</div>
