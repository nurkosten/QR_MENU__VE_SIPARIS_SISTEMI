@model LoginViewModel
@{
    ViewData["Title"] = "Personel girişi";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h1>Personel girişi</h1>
    <p class="lead-sub">Yönetim, restoran sahibi, personel ve mutfak ekranlarına erişmek için hesabınızla giriş yapın.</p>

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="E-posta adresiniz" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <label class="form-check remember-check mb-3">
            <input class="form-check-input" type="checkbox" id="RememberMe" name="RememberMe" value="true" />
            <span class="form-check-label">Beni hatırla</span>
        </label>

        <button class="btn btn-primary btn-lg btn-block" type="submit">Giriş yap</button>
    </form>

    <p class="text-center mt-4 mb-0">
        <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Index">
            <partial name="_Icon" model='"arrow-left"' /> Müşteri menüsüne dön
        </a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
