@model CartPageViewModel
@{
    ViewData["Title"] = "Sepet";
    var itemCount = Model.Lines.Sum(l => l.Quantity);
}

<div class="page-head">
    <div>
        <h1>Sepetiniz</h1>
        <p class="page-sub">
            @if (Model.Table is not null)
            {
                <span>@Model.Table.Name · </span>
            }
            <span>@itemCount ürün</span>
        </p>
    </div>
    @if (Model.Table is not null && Model.Restaurant is not null)
    {
        <div class="page-actions">
            <a class="btn btn-outline-dark btn-sm"
               asp-controller="Menu" asp-action="Index"
               asp-route-restaurantToken="@Model.Restaurant.PublicToken"
               asp-route-tableToken="@Model.Table.QrToken"
               asp-route-tableId="@Model.Table.Id">
                <partial name="_Icon" model='"arrow-left"' /> Menüye dön
            </a>
        </div>
    }
</div>

@if (Model.Lines.Count == 0)
{
    <div class="panel">
        <div class="empty">
            <div class="empty-icon"><partial name="_Icon" model='"bag"' /></div>
            <div class="empty-title">Sepetiniz boş</div>
            <p class="empty-text">Menüden ürün ekleyerek siparişinizi oluşturabilirsiniz.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Index">Menüye git</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">Ürünler</h2>
                    <span class="chip">@Model.Lines.Count satır</span>
                </div>
                @foreach (var line in Model.Lines)
                {
                    <div class="cart-line">
                        <div class="min-w-0">
                            <div class="cart-line-name">@line.Name</div>
                            <div class="cart-line-meta">@line.UnitPrice.ToString("C") × @line.Quantity</div>
                            @if (!string.IsNullOrWhiteSpace(line.Note))
                            {
                                <div class="cart-line-meta">Not: @line.Note</div>
                            }
                        </div>
                        <div class="cart-line-total">@line.LineTotal.ToString("C")</div>
                        <div class="cart-line-actions">
                            <form asp-action="Update" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="hidden" name="note" value="@line.Note" />
                                <span class="qty">
                                    <button type="button" class="qty-btn" data-step="down" aria-label="Azalt">&minus;</button>
                                    <input type="number" name="quantity" value="@line.Quantity" min="0" max="20" inputmode="numeric" aria-label="Adet" />
                                    <button type="button" class="qty-btn" data-step="up" aria-label="Artır">&plus;</button>
                                </span>
                                <button type="submit" class="btn btn-outline-dark btn-sm">Güncelle</button>
                            </form>
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="hidden" name="note" value="@line.Note" />
                                <button type="submit" class="btn btn-ghost btn-sm">Kaldır</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel">
                <div class="panel-head">
                    <h2 class="panel-title">Sipariş özeti</h2>
                </div>
                <div class="panel-body">
                    <div class="summary mb-3">
                        <div class="summary-row"><span>Ürün adedi</span><span>@itemCount</span></div>
                        <div class="summary-row"><span>Ara toplam</span><span>@Model.Total.ToString("C")</span></div>
                        <div class="summary-row total"><span>Toplam</span><span>@Model.Total.ToString("C")</span></div>
                    </div>
                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <label class="form-label" for="customerNote">Sipariş notu</label>
                        <textarea id="customerNote" name="customerNote" class="form-control" rows="3"
                                  placeholder="Mutfağa iletmek istediğiniz bir not var mı?" maxlength="300"></textarea>
                        <button type="submit" class="btn btn-primary btn-lg btn-block mt-3">
                            <partial name="_Icon" model='"check"' /> Siparişi mutfağa gönder
                        </button>
                        <p class="field-hint text-center mt-2">Gönderdikten sonra siparişinizi canlı takip edebilirsiniz.</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
