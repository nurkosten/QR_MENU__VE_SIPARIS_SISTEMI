@model Restaurant?
@{
    ViewData["Title"] = Model?.Name ?? "QR Restoran Menü";
}

<section class="menu-hero mb-4">
    <h1>@(Model?.Name ?? "QR Restoran Menü")</h1>
    <p class="hero-note">
        @(string.IsNullOrWhiteSpace(Model?.Description)
            ? "Masaya özel QR kod ile açılan dijital menü ve sipariş yönetim sistemi."
            : Model!.Description)
    </p>
    <div class="hero-meta">
        @if (!string.IsNullOrWhiteSpace(Model?.Address))
        {
            <span class="chip"><partial name="_Icon" model='"pin"' /> @Model!.Address</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model?.Phone))
        {
            <span class="chip"><partial name="_Icon" model='"phone"' /> @Model!.Phone</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model?.WorkingHours))
        {
            <span class="chip"><partial name="_Icon" model='"clock"' /> @Model!.WorkingHours</span>
        }
    </div>
</section>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-head">
                <h2 class="panel-title">Menü nasıl açılır?</h2>
            </div>
            <div class="panel-body">
                <div class="empty">
                    <div class="empty-icon"><partial name="_Icon" model='"qr"' /></div>
                    <div class="empty-title">Aktif masa bulunamadı</div>
                    <p class="empty-text">
                        Müşteri menüsü masaya özel QR kod ile açılır. Yönetim panelinden aktif bir masa
                        oluşturduğunuzda menü bağlantısı burada devreye girer.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-head">
                <h2 class="panel-title">Yönetim</h2>
            </div>
            <div class="panel-body">
                <p class="text-muted">Masa, kategori, ürün ve siparişleri yönetmek için panele giriş yapın.</p>
                <a class="btn btn-primary btn-block" asp-controller="Account" asp-action="Login">
                    <partial name="_Icon" model='"shield"' /> Yönetim paneline git
                </a>
            </div>
        </div>
    </div>
</div>
