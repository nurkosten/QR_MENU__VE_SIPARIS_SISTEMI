@model Restaurant?
@{
    ViewData["Title"] = Model?.Name ?? "QR Restoran Menü";
    var isStaff = User.Identity?.IsAuthenticated == true
        && (User.IsInRole(AppRoles.Admin)
            || User.IsInRole(AppRoles.Sahip)
            || User.IsInRole(AppRoles.Personel)
            || User.IsInRole(AppRoles.Mutfak));
}

<section class="menu-hero mb-4">
    <h1>@(Model?.Name ?? "QR Restoran Menü")</h1>
    <p class="hero-note">
        @(string.IsNullOrWhiteSpace(Model?.Description)
            ? "Masaya özel QR kod ile açılan dijital menü."
            : Model!.Description)
    </p>
    <div class="hero-meta">
        @if (!string.IsNullOrWhiteSpace(Model?.Address))
        {
            <span class="chip"><partial name="_Icon" model='"pin"' /> @Model!.Address</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model?.Phone))
        {
            <span class="chip"><partial name="_Icon" model='"phone"' /> @Model!.Phone</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model?.WorkingHours))
        {
            <span class="chip"><partial name="_Icon" model='"clock"' /> @Model!.WorkingHours</span>
        }
    </div>
</section>

<div class="panel">
    <div class="panel-body">
        <div class="empty">
            <div class="empty-icon"><partial name="_Icon" model='"qr"' /></div>
            <div class="empty-title">Menü şu anda kapalı</div>
            <p class="empty-text">
                Menü masadaki QR kod ile açılır. Şu anda bu işletme için aktif bir masa bulunmuyor.
            </p>
            @if (isStaff && (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Sahip)))
            {
                <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="Tables" asp-action="Create">
                    <partial name="_Icon" model='"plus"' /> Masa oluştur
                </a>
            }
        </div>
    </div>
</div>
