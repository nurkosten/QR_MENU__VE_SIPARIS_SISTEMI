@model MenuPageViewModel
@{
    ViewData["Title"] = Model.Restaurant.Name;
    var visibleCategories = Model.Categories.Where(c => c.Products.Count > 0).ToList();
    var productCount = visibleCategories.Sum(c => c.Products.Count);
    var isFiltered = Model.CategoryId is not null || !string.IsNullOrWhiteSpace(Model.Search);
    var qrToken = Model.MenuQrToken;
    var tableId = Model.Table?.Id;
    string CategoryIcon(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("burger") || n.Contains("yemek") || n.Contains("ana")) return "dish";
        if (n.Contains("tatlı") || n.Contains("tatli")) return "star";
        if (n.Contains("sıcak") || n.Contains("sicak") || n.Contains("kahve") || n.Contains("çay")) return "flame";
        if (n.Contains("soğuk") || n.Contains("soguk") || n.Contains("içecek") || n.Contains("icecek")) return "cup";
        return "layers";
    }
}

<div class="menu-stage">
<section class="menu-hero">
    <span class="hero-orb hero-orb-a" aria-hidden="true"></span>
    <div class="hero-copy">
        <p class="hero-kicker">Dijital menü</p>
        <div class="hero-title-row">
            @if (!string.IsNullOrWhiteSpace(Model.Restaurant.LogoUrl))
            {
                <img class="hero-logo" src="@Model.Restaurant.LogoUrl" alt="" />
            }
            <h1>@Model.Restaurant.Name</h1>
        </div>
        <p class="hero-note">@(Model.Table?.Name ?? "Masa") için hazır. Seçiminiz doğrudan bu masaya gider.</p>
        <div class="hero-meta">
            @if (Model.Table is not null)
            {
                <span class="chip"><partial name="_Icon" model='"table"' /> @Model.Table.Name</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Restaurant.WorkingHours))
            {
                <span class="chip"><partial name="_Icon" model='"clock"' /> @Model.Restaurant.WorkingHours</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Restaurant.Phone))
            {
                <span class="chip"><partial name="_Icon" model='"phone"' /> @Model.Restaurant.Phone</span>
            }
        </div>
    </div>
</section>

    <div class="menu-toolbar">
        <form method="get" class="search-field">
            <partial name="_Icon" model='"search"' />
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
            <input type="hidden" name="tableId" value="@tableId" />
            <input name="q" value="@Model.Search" class="form-control" placeholder="Menüde ara…" aria-label="Menüde ara" />
        </form>
        <nav class="cat-nav" aria-label="Kategoriler">
            <a class="cat-chip @(Model.CategoryId is null ? "on" : "")"
               href="@Url.Action("Index", new { restaurantToken = Model.Restaurant.PublicToken, tableToken = qrToken, tableId, q = Model.Search })">
                <span class="cat-ico"><partial name="_Icon" model='"layers"' /></span>
                Tümü
            </a>
            @foreach (var category in Model.Categories)
            {
                <a class="cat-chip @(Model.CategoryId == category.Id ? "on" : "")"
                   href="@Url.Action("Index", new { restaurantToken = Model.Restaurant.PublicToken, tableToken = qrToken, tableId, categoryId = category.Id, q = Model.Search })">
                    <span class="cat-ico"><partial name="_Icon" model="CategoryIcon(category.Name)" /></span>
                    @category.Name
                </a>
            }
        </nav>
    </div>

    <div class="service-row">
        <form asp-controller="Service" asp-action="RequestHelp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="restaurantToken" value="@Model.Restaurant.PublicToken" />
            <input type="hidden" name="tableToken" value="@qrToken" />
            <input type="hidden" name="tableId" value="@tableId" />
            <input type="hidden" name="type" value="@ServiceRequestType.CallWaiter" />
            <button type="submit" class="service-btn">
                <span class="service-ico"><partial name="_Icon" model='"bell"' /></span>
                <span>
                    <span class="service-label">Garson çağır</span>
                    <span class="service-hint">Masaya gelir</span>
                </span>
            </button>
        </form>
        <form asp-controller="Service" asp-action="RequestHelp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="restaurantToken" value="@Model.Restaurant.PublicToken" />
            <input type="hidden" name="tableToken" value="@qrToken" />
            <input type="hidden" name="tableId" value="@tableId" />
            <input type="hidden" name="type" value="@ServiceRequestType.RequestBill" />
            <button type="submit" class="service-btn service-btn-bill">
                <span class="service-ico"><partial name="_Icon" model='"bill"' /></span>
                <span>
                    <span class="service-label">Hesap iste</span>
                    <span class="service-hint">Ödeme için</span>
                </span>
            </button>
        </form>
    </div>

    @if (productCount == 0)
    {
        <div class="panel">
            <div class="empty">
                <div class="empty-icon"><partial name="_Icon" model='"search"' /></div>
                <div class="empty-title">Ürün bulunamadı</div>
                <p class="empty-text">
                    @(isFiltered
                        ? "Aramanıza veya seçtiğiniz kategoriye uygun ürün yok. Filtreyi temizleyip tekrar deneyin."
                        : "Menü şu anda hazırlanıyor. Kısa süre içinde ürünler burada listelenecek.")
                </p>
                @if (isFiltered)
                {
                    <a class="btn btn-soft btn-sm" href="@Url.Action("Index", new { restaurantToken = Model.Restaurant.PublicToken, tableToken = qrToken, tableId })">Filtreyi temizle</a>
                }
            </div>
        </div>
    }
    else
    {
        ViewData["RestaurantToken"] = Model.Restaurant.PublicToken;
        ViewData["QrToken"] = qrToken;
        ViewData["TableId"] = tableId;
        foreach (var category in visibleCategories)
        {
            <section class="menu-section" id="kategori-@category.Id">
                <div class="menu-section-head">
                    <h2>@category.Name</h2>
                    <span class="count">@category.Products.Count ürün</span>
                </div>
                <div class="product-list">
                    @foreach (var product in category.Products)
                    {
                        <partial name="_MenuProductCard" model="product" />
                    }
                </div>
            </section>
        }
    }
</div>
