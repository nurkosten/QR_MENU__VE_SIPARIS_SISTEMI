@model ErrorViewModel
@{
    ViewData["Title"] = "Beklenmeyen hata";
}
<div class="state-page">
    <div>
        <div class="state-code">500</div>
        <h1 class="state-title">Bir şeyler ters gitti</h1>
        <p class="state-text">İşlem tamamlanamadı. Kısa süre sonra tekrar deneyin; sorun sürerse yöneticinize bildirin.</p>
        @if (Model.ShowRequestId)
        {
            <p class="field-hint">İstek numarası: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
    </div>
</div>
