@{
    var cart = Context.Session.GetCart();
    var cartCount = cart?.Lines.Sum(l => l.Quantity) ?? 0;
    var cartTable = cart?.TableName;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#10161f" />
    <title>@ViewData["Title"] · QR Menü</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="guest-ui">
    <div class="page-wrap">
        <header class="site-header">
            <div class="page-shell site-header-inner">
                <a class="site-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><partial name="_Icon" model='"dish"' /></span>
                    <span>
                        <span class="brand-name d-block">QR Menü</span>
                        <span class="brand-sub">@(cartTable ?? "Dijital sipariş")</span>
                    </span>
                </a>
                <div class="topbar-spacer"></div>
                @if (cartCount > 0)
                {
                    <a class="btn btn-soft btn-sm" asp-controller="Cart" asp-action="Index">
                        <partial name="_Icon" model='"bag"' />
                        <span class="d-none d-sm-inline">Sepet</span>
                        <span class="cart-count-badge">@cartCount</span>
                    </a>
                }
                <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">
                    <partial name="_Icon" model='"shield"' />
                    <span class="d-none d-sm-inline">Personel girişi</span>
                </a>
            </div>
        </header>

        <main class="page-body">
            <div class="page-shell">
                @RenderBody()
            </div>
        </main>

        <footer class="site-footer">
            <div class="page-shell d-flex flex-wrap justify-content-between gap-2">
                <span>QR Restoran Menü ve Sipariş Yönetim Sistemi</span>
                <span>&copy; @DateTime.Now.Year</span>
            </div>
        </footer>
    </div>

    <partial name="_Toasts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
