@{
    var cart = Context.Session.GetCart();
    var cartCount = cart?.Lines.Sum(l => l.Quantity) ?? 0;
    var cartTable = cart?.TableName;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isMenu = string.Equals(controller, "Menu", StringComparison.OrdinalIgnoreCase);
    var isCart = string.Equals(controller, "Cart", StringComparison.OrdinalIgnoreCase);
    var hasTable = !string.IsNullOrWhiteSpace(cart?.RestaurantToken) && !string.IsNullOrWhiteSpace(cart?.TableToken);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <title>@ViewData["Title"] · QR Menü</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="guest-ui">
    <div class="page-wrap">
        <header class="site-header">
            <div class="page-shell site-header-inner">
                <a class="site-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><partial name="_Icon" model='"dish"' /></span>
                    <span>
                        <span class="brand-name d-block">QR Menü</span>
                        <span class="brand-sub">@(string.IsNullOrWhiteSpace(cartTable) ? "Dijital sipariş" : cartTable)</span>
                    </span>
                </a>
                <div class="topbar-spacer"></div>
                <a class="guest-icon-btn" asp-controller="Account" asp-action="Login" title="Personel girişi">
                    <partial name="_Icon" model='"shield"' />
                    <span class="visually-hidden">Personel girişi</span>
                </a>
            </div>
        </header>

        <main class="page-body">
            <div class="page-shell">
                @RenderBody()
            </div>
        </main>
    </div>

    <nav class="guest-dock" aria-label="Misafir gezinti">
        @if (hasTable)
        {
            <a class="dock-item @(isMenu ? "on" : "")"
               asp-controller="Menu" asp-action="Index"
               asp-route-restaurantToken="@cart!.RestaurantToken"
               asp-route-tableToken="@cart.TableToken"
               asp-route-tableId="@cart.TableId">
                <partial name="_Icon" model='"dish"' />
                Menü
            </a>
        }
        else
        {
            <a class="dock-item @(isMenu ? "on" : "")" asp-controller="Home" asp-action="Index">
                <partial name="_Icon" model='"dish"' />
                Menü
            </a>
        }
        <a class="dock-item @(isCart ? "on" : "")" asp-controller="Cart" asp-action="Index">
            <partial name="_Icon" model='"bag"' />
            @if (cartCount > 0)
            {
                <span class="dock-badge">@cartCount</span>
            }
            Sepet
        </a>
    </nav>

    <partial name="_Toasts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewBag.PreviewMode is true)
    {
        <script>
            (function () {
                try {
                    var channel = new BroadcastChannel('rm-customer-preview');
                    channel.onmessage = function (event) {
                        var data = event && event.data;
                        if (!data) {
                            return;
                        }
                        if (data.home) {
                            if (location.pathname !== '/') {
                                location.replace('/');
                            }
                            return;
                        }
                        if (!data.restaurantToken || !data.tableToken) {
                            return;
                        }
                        var next = '/menu/' + encodeURIComponent(data.restaurantToken) + '/' + encodeURIComponent(data.tableToken) + '?preview=1';
                        if (location.pathname.toLowerCase() + location.search.toLowerCase() !== next.toLowerCase()) {
                            location.replace(next);
                        }
                    };
                } catch (e) { }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
