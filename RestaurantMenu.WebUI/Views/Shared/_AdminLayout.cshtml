<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="theme-app">
    <div class="blobs" aria-hidden="true">
        <div class="blob a"></div>
        <div class="blob b"></div>
        <div class="blob c"></div>
    </div>
    <div class="d-flex min-vh-100 shell">
        <aside class="app-nav">
            <h5 class="mb-4">QR Menü</h5>
            @if (User.IsInRole(AppRoles.Admin))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Özet</a>
                <a asp-area="Admin" asp-controller="Restaurant" asp-action="Edit">İşletme</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Kategoriler</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">Ürünler</a>
                <a asp-area="Admin" asp-controller="Tables" asp-action="Index">Masalar / QR</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Siparişler</a>
                <a asp-area="Admin" asp-controller="Reports" asp-action="Index">Raporlar</a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
            }
            @if (User.IsInRole(AppRoles.Personel) || User.IsInRole(AppRoles.Admin))
            {
                <a asp-area="Staff" asp-controller="StaffOrders" asp-action="Index">Personel ekranı</a>
            }
            @if (User.IsInRole(AppRoles.Mutfak) || User.IsInRole(AppRoles.Admin))
            {
                <a asp-area="Kitchen" asp-controller="KitchenOrders" asp-action="Index">Mutfak ekranı</a>
            }
            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="mt-4">
                <button class="btn btn-outline-light btn-sm w-100">Çıkış</button>
            </form>
        </aside>
        <main class="flex-grow-1 p-4 admin-main">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
