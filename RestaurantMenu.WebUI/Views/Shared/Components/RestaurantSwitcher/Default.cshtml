@model RestaurantSwitcherViewModel
@{
    var restaurants = Model.Restaurants;
}

@if (restaurants.Count == 0)
{
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="rest-switch-empty" asp-area="Admin" asp-controller="Restaurant" asp-action="Create">Restoran ekle</a>
    }
    else
    {
        <div class="rest-switch-label">Restoran atanmadı</div>
    }
}
else if (!Model.CanSwitch || restaurants.Count == 1)
{
    var name = restaurants.FirstOrDefault(r => r.Id == Model.SelectedId)?.Name ?? restaurants[0].Name;
    <div class="rest-switch-label" title="@name">@name</div>
}
else
{
    <form asp-area="" asp-controller="Workspace" asp-action="Select" method="post" class="rest-switch-form">
        <label class="visually-hidden" for="restaurant-switch">Restoran seç</label>
        <select id="restaurant-switch" name="id" class="rest-switch" onchange="this.form.submit()">
            @foreach (var restaurant in restaurants)
            {
                if (restaurant.Id == Model.SelectedId)
                {
                    <option value="@restaurant.Id" selected>@restaurant.Name</option>
                }
                else
                {
                    <option value="@restaurant.Id">@restaurant.Name</option>
                }
            }
        </select>
    </form>
}
